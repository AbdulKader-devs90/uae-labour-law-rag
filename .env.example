# Choose nebius or groq; configure the corresponding provider below.
LLM_PROVIDER=nebius
NEBIUS_API_KEY=your-nebius-api-key
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/
NEBIUS_MODEL=your-nebius-model-id
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=your-groq-model-id
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=your-langsmith-api-key
LANGSMITH_PROJECT=your-langsmith-project
JUDGE_MODEL=your-judge-model-id
# Model runtime settings (the app also sets these defaults).
OMP_NUM_THREADS=1
KMP_DUPLICATE_LIB_OK=TRUE
TOKENIZERS_PARALLELISM=false
